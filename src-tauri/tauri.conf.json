{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heim-AI",
  "version": "0.1.0",
  "identifier": "de.heimai.windows",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Heim-AI",
        "width": 1120,
        "height": 740,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/openwakeword/*": "openwakeword/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"]
      }
    }
  }
}
